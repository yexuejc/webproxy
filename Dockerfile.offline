# 完全离线构建：依赖已通过 `go mod vendor` 打包进 vendor/ 目录，构建时不联网。
# 用法：docker build -f Dockerfile.offline -t webproxy:latest .
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor/ vendor/
RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -trimpath -o /out/webproxy .

FROM alpine:3.20
# ca-certificates 用于校验目标站点 HTTPS 证书
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=build /out/webproxy /app/webproxy
COPY config.json /app/config.json
COPY static/index.html /app/static/index.html

EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8765/ >/dev/null 2>&1 || exit 1

CMD ["/app/webproxy"]
